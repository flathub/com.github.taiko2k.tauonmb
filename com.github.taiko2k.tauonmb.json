{
    "app-id": "com.github.taiko2k.tauonmb",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "tauon",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--device-if=all:!has-input-device",
        "--device=input",
        "--filesystem=xdg-music",
        "--filesystem=xdg-download",
        "--filesystem=xdg-run/app/com.discordapp.Discord:create",
        "--filesystem=xdg-run/discord-ipc-0",
        "--filesystem=xdg-run/pipewire-0",
        "--system-talk-name=org.freedesktop.login1",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--own-name=org.mpris.MediaPlayer2.tauon"
    ],
    "modules": [
        "shared-modules/libappindicator/libappindicator-gtk3-introspection-12.10.json",
        "python-pylast.json",
        "python3-scikit-build-core.json",
        "python-dbus-deps.json",
        "python3-poetry-core.json",
        "python3-modules.json",
        "python3-PyOpenGL.json",
        "projectm.json",
        "fonts.json",
        "chromaprint.json",
        {
            "name": "libopenmpt",
            "buildsystem": "autotools",
            "config-opts": [
                "--without-portaudio",
                "--disable-examples"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://lib.openmpt.org/files/libopenmpt/src/libopenmpt-0.8.7+release.autotools.tar.gz",
                    "sha256": "275c29ef47be9992f62a35fcc96f7ca05c06d2fd05c9298b8dee9f743f75b089"
                }
            ],
            "cleanup": [
                "*.la",
                "*.a",
                "/include"
            ]
        },
        {
            "name": "libgme",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libgme/game-music-emu/archive/refs/tags/0.6.5.tar.gz",
                    "sha256": "8531678502451c2cf04248cda45c8b4645e19fcfb63e6a7ec2549641c47bb392"
                }
            ],
            "cleanup": [
                "*.la",
                "*.a",
                "/include",
                "/bin",
                "/share/man"
            ]
        },
        {
            "name": "tauonmb-git",
            "buildsystem": "simple",
            "build-options": {
                "append-path" : "/usr/lib/sdk/rust-stable/bin",
                "env" : {
                    "CARGO_HOME" : "/run/build/tauonmb-git/cargo"
                }
            },
            "build-commands": [
                "cargo --offline fetch --manifest-path src/lrclib-solver/Cargo.toml --verbose",
                "cargo build --release --offline --manifest-path src/lrclib-solver/Cargo.toml --bin lrclib-solver",

                "pip3 install --verbose --no-index --no-build-isolation --no-deps --prefix=${FLATPAK_DEST} .",

                "cp src/lrclib-solver/target/release/lrclib-solver ${FLATPAK_DEST}/lib/python3*/site-packages/tauon/",
                "mkdir -p ${FLATPAK_DEST}/share/locale",
                "cp -r ${FLATPAK_DEST}/lib/python3*/site-packages/tauon/locale/. ${FLATPAK_DEST}/share/locale/",
                "rm -rf ${FLATPAK_DEST}/lib/python3*/site-packages/tauon/locale",

                "install -D extra/tauonmb.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/${FLATPAK_ID}.svg",
                "install -D extra/tauonmb-symbolic.svg ${FLATPAK_DEST}/share/icons/hicolor/symbolic/apps/${FLATPAK_ID}-symbolic.svg",
                "install -D src/tauon/assets/icon-64.png ${FLATPAK_DEST}/share/icons/hicolor/64x64/apps/${FLATPAK_ID}.png",
                "install -D src/tauon/assets/icon-128.png ${FLATPAK_DEST}/share/icons/hicolor/128x128/apps/${FLATPAK_ID}.png",
                "install -D extra/com.github.taiko2k.tauonmb.metainfo.xml ${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.metainfo.xml",
                "mkdir -p ${FLATPAK_DEST}/share/applications",
                "sed -e 's|^Icon=tauonmb$|Icon=com.github.taiko2k.tauonmb|' extra/tauonmb.desktop > ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop"
            ],
            "sources": [
                "lrclib-solver-cargo-sources.json",
                {
                    "type": "git",
                    "url": "https://github.com/Taiko2k/Tauon.git",
                    "commit": "320da84391e1b1d09bde9bcae0d48192d10175ec"
                }
            ]
        },
        "zenity.json"
    ]
}
