{
    "name": "sdl3",
    "modules": [
        {
            "name": "SDL3",
            "builddir": true,
            "buildsystem": "cmake-ninja",
            "cleanup": [
                "/include",
                "/lib/*.la",
                "/lib/*.a",
                "/lib/cmake",
                "/share/aclocal",
                "/lib/pkgconfig"
            ],
            "config-opts": [
                "-DCMAKE_VERBOSE_MAKEFILE=ON",
                "-DCMAKE_BUILD_TYPE:STRING=Release",
                "-DCMAKE_INSTALL_LIBDIR:PATH=lib"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libsdl-org/SDL/releases/download/release-3.2.28/SDL3-3.2.28.tar.gz",
                    "sha256": "1330671214d146f8aeb1ed399fc3e081873cdb38b5189d1f8bb6ab15bbc04211"
                }
            ]
        },
        {
            "name": "sdl3_image",
            "builddir": true,
            "buildsystem": "cmake-ninja",
            "cleanup": [
                "/include",
                "/lib/*.la",
                "/lib/*.a",
                "/lib/cmake",
                "/share/aclocal",
                "/lib/pkgconfig"
            ],
            "config-opts": [
                "-DCMAKE_VERBOSE_MAKEFILE=ON",
                "-DCMAKE_BUILD_TYPE:STRING=Release",
                "-DCMAKE_INSTALL_LIBDIR:PATH=lib"
            ],
            "sources":[
                {
                    "type": "archive",
                    "url": "https://github.com/libsdl-org/SDL_image/releases/download/release-3.2.4/SDL3_image-3.2.4.tar.gz",
                    "sha256": "a725bd6d04261fdda0dd8d950659e1dc15a8065d025275ef460d32ae7dcfc182"
                }
            ]
        }
    ]
}
