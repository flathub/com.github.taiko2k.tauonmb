{
  "name": "projectm",
  "buildsystem": "cmake-ninja",
  "build-options": {
    "cxxflags": "-fPIC",
    "cflags": "-fPIC"
  },
  "config-opts": [
    "-DCMAKE_BUILD_TYPE=Release",
    "-DBUILD_SHARED_LIBS=ON",
    "-DENABLE_INSTALL=ON",
    "-DENABLE_SDL_UI=OFF",
    "-DBUILD_TESTING=OFF",
    "-DBUILD_DOCS=OFF",
    "-DENABLE_GLES=ON",
    "-DENABLE_SYSTEM_GLM=ON",
    "-DENABLE_SYSTEM_PROJECTM_EVAL=OFF",
    "-DENABLE_PLAYLIST=OFF"
  ],
  "modules": [
    "glm.json",
    "fftw3f.json"
  ],
  "sources": [
    {
      "type": "git",
      "url": "https://github.com/projectM-visualizer/projectm",
      "commit": "4d2849333b63235a6af4d1f02508a97529d96dc7"
    }
  ],
  "cleanup": [
    "*.la",
    "/bin",
    "/share/doc",
    "/share/man"
  ]
}
