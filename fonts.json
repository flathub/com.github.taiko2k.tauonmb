{
    "name": "fonts",
    "modules": [
        {
            "name": "noto-fonts",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/fonts",
                "install -D NotoSans/hinted/ttf/NotoSans-Bold.ttf /app/share/fonts/",
                "install -D NotoSans/hinted/ttf/NotoSans-Medium.ttf /app/share/fonts/",
                "install -D NotoSans/hinted/ttf/NotoSans-Regular.ttf /app/share/fonts/",
                "install -D NotoSans/hinted/ttf/NotoSans-ExtraCondensed.ttf /app/share/fonts/",
                "install -D NotoSans/hinted/ttf/NotoSans-ExtraCondensedBold.ttf /app/share/fonts/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/notofonts/latin-greek-cyrillic/releases/download/NotoSans-v2.015/NotoSans-v2.015.zip",
                    "sha256": "0c34df072a3fa7efbb7cbf34950e1f971a4447cffe365d3a359e2d4089b958f5"
                }
            ]
        },
        {
            "name": "noto-font-cjk",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/share/fonts",
                "install -D NotoSansCJK.ttc /app/share/fonts/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/notofonts/noto-cjk/releases/download/Sans2.004/00_NotoSansCJK.ttc.zip",
                    "sha256": "a56077736038875f3a5b1e6715b2713a2bd049cc0bf0dfdf645927b070d38bfc"
                }
            ]
        }
    ]
}